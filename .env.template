# Configuration for the GP2 clinical GWAS notebooks.
# Copy to .env, fill in, and load before starting Jupyter:
#
#     set -a; source .env; set +a
#
# .env itself must stay out of git - it holds credentials.

# --- Release ---------------------------------------------------------------
GWAS_RELEASE=12

# --- Local or VM layout ----------------------------------------------------------
# Root of the analysis VM's scratch space; the gcsfuse mounts live underneath
GWAS_WORK_DIR=$HOME/gwas

# Fast local scratch for intermediate genotype files.
GWAS_TMP_DIR=/dev/shm

# Reference files: hg38 fasta, liftOver chains, 1000 Genomes panel, TOPMed panel.
GWAS_REF_DIR=$HOME/gwas/ref_files

# --- Buckets (names only, no gs:// prefix) ---------------------------------
GWAS_TIER2_BUCKET=
GWAS_WORK_BUCKET=

# Folder inside the working bucket that this project writes to.
GWAS_PREFIX=

# Folder inside the working bucket holding the curated clinical datasets,
# relative to the mount (e.g. <team>/Progression/datasets).
GWAS_CLINICAL_DIR=

# Curated dataset filenames - they carry a build date, so update them when a
# new version is released.
GWAS_CLIN_NBA_CS=clin_combined_cs_dataset_for_LR_YYYY-MM-DD.csv
GWAS_CLIN_NBA_SURV=clin_combined_surv_dataset_for_CPH_YYYY-MM-DD.csv
GWAS_CLIN_NON_NBA_CS=non_nba_clin_hy_cs_dataset_for_LR_YYYY-MM-DD.csv
GWAS_CLIN_NON_NBA_SURV=non_nba_clin_surv_dataset_for_CPH_YYYY-MM-DD.csv

# --- Pipelines and tooling -------------------------------------------------
# Clone of the LongGWAS pipeline that will be run.
GWAS_PIPELINE_DIR=$HOME/gwas/long-gwas-pipeline

# gs:// URI of the pipeline's reference bundle.
GWAS_REFERENCE_DIR=

# Only needed by 00_genotools_qc_imputation.ipynb (non-NBA cohorts).
GWAS_GENOTOOLS_DIR=$HOME/gwas/GenoTools
GWAS_QC_CODE_DIR=$HOME/gwas/genetics-qc

# --- Nextflow on Google Batch / Seqera Platform ----------------------------
GWAS_TOWER_ORG=
GWAS_TOWER_WORKSPACE_ID=
TOWER_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# --- locuscompare_setaxes.R ------------------------------------------------
# Free LDlink token: https://ldlink.nih.gov/?tab=apiaccess
LDLINK_TOKEN=
LC_RISK_FILE=
LC_PROGRESSION_FILE=
LC_OUT_DIR=

# --- TOPMed imputation (notebook 00) ---------------------------------------
TOPMED_JOB_ID=
TOPMED_JOB_PASSWORD=
